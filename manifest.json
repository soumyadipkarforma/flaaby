{
  "manifest_version": 3,
  "name": "FLAABY - Flappy Dino",
  "version": "1.0.0",
  "description": "A flappy-bird-style game in the classic dino monochrome look. Click the toolbar icon or press Alt+Shift+F to play.",
  "action": {
    "default_title": "Play FLAABY"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Play FLAABY"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}